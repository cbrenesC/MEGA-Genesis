# Credenciales de la Meteomatics Weather API (planificador de clima del lanzamiento).
# En Netlify: Site configuration → Environment variables. En local: copia este archivo a .env (no se sube al repositorio)
# y usa `netlify dev` para que la función netlify/functions/meteomatics.mjs las lea.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
